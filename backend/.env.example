PROJECT_NAME="LOGIMIND v2 - AI Logistics Intelligence Platform"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="logimind-enterprise-secret-key-change-in-production-random-hash-9382479238"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# Database Connection
# SQLite (default for instant zero-dependency local run)
DATABASE_URL="sqlite:///./logimind_v2.db"

# MySQL Production Configuration:
# DATABASE_URL="mysql+pymysql://logimind_user:logimind_pass@localhost:3306/logimind_v2"

# AI & LLM Integrations
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
AI_CONFIDENCE_THRESHOLD=0.85

# Weather & Maps Integrations
WEATHER_API_KEY=""

# Email Notifications
